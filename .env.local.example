# Supabase — salin file ini ke .env.local dan isi dengan credentials project kamu
# Dapatkan dari: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Notifikasi email inquiry (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=contact@crafyne.com

# Cloudflare Turnstile — proteksi bot untuk form inquiry.
# Buat widget di: https://dash.cloudflare.com → Turnstile → Add widget
#
# Keduanya opsional. Tanpa secret key, verifikasi dilewati dan form tetap
# berfungsi. Begitu TURNSTILE_SECRET_KEY diisi, verifikasi jadi WAJIB —
# isi juga site key-nya, kalau tidak semua submission akan ditolak.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (opsional) — https://umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
